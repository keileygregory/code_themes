  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#a0aed3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#76cdff"
      }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage", "storage.type"],
      "settings": {
        "foreground": "#8044e7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Methods",
      "scope": ["entity.name.function.member", "meta.method-call"],
      "settings": {
        "foreground": "#3173e4"
      }
    },
    {
      "name": "Types / Classes",
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
      "settings": {
        "foreground": "#c38dfb",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "meta.object-literal.key"],
      "settings": {
        "foreground": "#c38dfb"
      }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#8044e7"
      }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#76cdff"
      }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": {
        "foreground": "#3173e4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#3173e4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#76cdff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": {
        "foreground": "#F0C674"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#F7768E",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#8044e7",
    "class": {
      "foreground": "#3173e4",
      "bold": true
    },
    "enum": "#c38dfb",
    "interface": "#3173e4",
    "struct": "#8044e7",
    "type": "#76cdff",
    "typeParameter": "#76cdff",

    "parameter": "#EAF0FF",
    "variable": "#c38dfb",
    "property": "#EAF0FF",
    "enumMember": "#3173e4",
    "event": "#76cdff",

    "function": "#989fff",
    "method": "#3173e4",
    "macro": "#8044e7",
    "decorator": "#c38dfb",

    "keyword": {
      "foreground": "#c38dfb",
      "bold": true
    },
    "comment": {
      "foreground": "#a0aed3",
      "italic": true
    },
    "string": "#3173e4",
    "number": "#c38dfb",
    "regexp": "#76cdff",
    "operator": "#EAF0FF",
    "brace": "#c38dfb",
    "bracket": "#c38dfb"
  }
}
