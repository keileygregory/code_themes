  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#F4EEFFaa",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#edabff"
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#944fc6"
      }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage", "storage.type"],
      "settings": {
        "foreground": "#944fc6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"],
      "settings": {
        "foreground": "#F4EEFF"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.parameter"],
      "settings": {
        "foreground": "#F4EEFF"
      }
    },
    {
      "name": "Constants",
      "scope": ["constant", "constant.language"],
      "settings": {
        "foreground": "#edabff"
      }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "variable.function"],
      "settings": {
        "foreground": "#edabff"
      }
    },
    {
      "name": "Methods",
      "scope": ["entity.name.function.member", "meta.method-call"],
      "settings": {
        "foreground": "#edabff"
      }
    },
    {
      "name": "Types / Classes",
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
      "settings": {
        "foreground": "#edabff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "meta.object-literal.key"],
      "settings": {
        "foreground": "#F4EEFF"
      }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#944fc6"
      }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#edabff"
      }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": {
        "foreground": "#f3e1fe",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#f3e1fe",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#edabff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": {
        "foreground": "#F4D35E"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#FF7DA6",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#edabff",
    "class": {
      "foreground": "#edabff",
      "bold": true
    },
    "enum": "#edabff",
    "interface": "#edabff",
    "struct": "#edabff",
    "type": "#edabff",
    "typeParameter": "#edabff",

    "parameter": "#F4EEFF",
    "variable": "#F4EEFF",
    "property": "#F4EEFF",
    "enumMember": "#edabff",
    "event": "#edabff",

    "function": "#edabff",
    "method": "#edabff",
    "macro": "#944fc6",
    "decorator": "#944fc6",

    "keyword": {
      "foreground": "#944fc6",
      "bold": true
    },
    "comment": {
      "foreground": "#F4EEFFaa",
      "italic": true
    },
    "string": "#edabff",
    "number": "#F4D35E",
    "regexp": "#7ED957",
    "operator": "#F4EEFF"
  }
}
